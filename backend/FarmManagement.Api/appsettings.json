  "Storage": { "UploadPath": "uploads" },
  "Cors": { "AllowedOrigins": ["http://localhost:5173", "https://localhost:5173"] },
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*"
}
